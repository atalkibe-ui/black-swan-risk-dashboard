# Runtime
HOST=127.0.0.1
PORT=8080

# Server-side refresh initiated by the header button
DATA_REFRESH_ENABLED=true
DATA_REFRESH_SCRIPT=/opt/black-swan-dashboard/current/deployment/refresh-data.sh
DATA_REFRESH_ROOT=/opt/black-swan-dashboard/current
DATA_REFRESH_STATE_FILE=/var/lib/black-swan-dashboard/runtime/data-refresh.json
DATA_REFRESH_TIMEOUT_MS=900000
PYTHON=/opt/black-swan-dashboard/venv/bin/python
CACHE_ROOT=/var/lib/black-swan-dashboard/source-cache
BLOOMBERG_WORKBOOK=/var/lib/black-swan-dashboard/input/Blackswan.xlsx
REOK_WORKBOOK=/var/lib/black-swan-dashboard/input/REOK.xlsx

# Uncomment when the bank uses an outbound HTTPS proxy or private CA.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.bank.local:3128
# NO_PROXY=127.0.0.1,localhost,.bank.local
# NODE_EXTRA_CA_CERTS=/etc/pki/ca-trust/source/anchors/bank-root-ca.pem
