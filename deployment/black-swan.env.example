# Runtime
HOST=127.0.0.1
PORT=8080
AI_TIMEOUT_MS=60000
MAX_REQUEST_BYTES=65536
AI_CACHE_FILE=/var/lib/black-swan-dashboard/runtime/latest-analysis.json
AI_PROMPT_FILE=/opt/black-swan-dashboard/current/server/prompts/analysis-prompt.txt

# Approved OpenAI-compatible endpoint
OPENAI_BASE_URL=https://ai-gateway.bank.local/v1
OPENAI_MODEL=approved-model-name
OPENAI_API_KEY=
AI_API_MODE=responses
AI_ENABLE_WEB_SEARCH=true

# Uncomment when the bank uses an outbound HTTPS proxy or private CA.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.bank.local:3128
# NO_PROXY=127.0.0.1,localhost,.bank.local
# NODE_EXTRA_CA_CERTS=/etc/pki/ca-trust/source/anchors/bank-root-ca.pem
